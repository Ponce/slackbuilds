#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.


cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=systran-faster-whisper-xxl-bin
VERSION=${VERSION:-245.4}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

D=Faster-Whisper-XXL
TARNAM="$D"_r"$VERSION"_linux.7z
PATCHELF_VERSION=0.19.2

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  UNSUP=1
elif [ "$ARCH" = "i686" ]; then
  UNSUP=1
elif [ "$ARCH" = "x86_64" ]; then
  UNSUP=0
elif [ "$ARCH" = "aarch64" ]; then
  UNSUP=1
else
  UNSUP=1
fi

if [[ "$UNSUP" == 1 ]] ; then
  printf "Unsupported architecture: $ARCH.\n" 1>&2
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP

rm -rf "$PRGNAM"_build
mkdir "$PRGNAM"_build
cd "$PRGNAM"_build
7z x $CWD/$TARNAM
tar xvf $CWD/patchelf-"$PATCHELF_VERSION"-"$ARCH".tar.gz
PATCHELF="$(readlink -f bin/patchelf)"

chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} + -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} +

"$PATCHELF" --clear-execstack "$D"/_xxl_data/ctranslate2.libs/libctranslate2-d3638643.so.4.4.0
"$PATCHELF" --clear-execstack "$D"/_xxl_data/libctranslate2-d3638643.so.4.4.0

install -d -m755 $PKG/opt
mv "$D" $PKG/opt
find -L $PKG/opt/"$D" -type d -exec chmod 755 {} +
find -L $PKG/opt/"$D" -type f -name '*.so*' -exec chmod 755 {} +
chmod +x $PKG/opt/Faster-Whisper-XXL/_xxl_data/torch/bin/torch_shm_manager
chmod +x $PKG/opt/Faster-Whisper-XXL/_xxl_data/torch/bin/protoc-3.13.0.0
chmod +x $PKG/opt/Faster-Whisper-XXL/_xxl_data/torch/bin/protoc


chmod 755 "$PKG/opt/$D/faster-whisper-xxl"

(
  cd "$PKG/opt/$D"
  mkdir -p "$PKG/var/tmp/whisper-cache"
  chmod 1777 "$PKG/var/tmp/whisper-cache"
  ln -sf "../../var/tmp/whisper-cache" .cache
)

mkdir -p "$PKG"/usr/bin
(
    cd $PKG/usr/bin
cat > $PKG/usr/bin/whisper <<"EOF"
#!/bin/bash
MODEL_DIR="$(readlink -f ~/.cache/Faster-Whisper-XXL/models)"
/opt/Faster-Whisper-XXL/faster-whisper-xxl --model_dir "$MODEL_DIR" --output_dir "./" "$@"
EOF
    chmod +x $PKG/usr/bin/whisper
)

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a \
   license.txt \
   $CWD/README \
   $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild
chown -R root:root $PKG/usr/doc/$PRGNAM-$VERSION

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

if [[ "${PRGNAM: -4}" != "-bin" ]] ; then
  printf "Fatal Error: PRGNAM must end in '-bin', but now ends with %s\n" \
         "${PRGNAM: -4}"
  exit 2
fi

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
