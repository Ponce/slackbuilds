#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=spfmilter
VERSION=${VERSION:-2.2}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" -o "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=$ARCH -mtune=i686"
elif [ "$ARCH" = "x86_64" -o "$ARCH" = "aarch64" ]; then
  SLKCFLAGS="-O2 -fPIC"
else
  SLKCFLAGS="-O2"
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $CWD/$PRGNAM-$VERSION.tar.gz --no-same-owner
cd $PRGNAM-$VERSION
find . ! -type l    -a \( \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \) \)

CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
./configure \
  --prefix=$PKG/usr \
  --mandir=$PKG/usr/man \
  --build=$ARCH-slackware-linux

make V=1
make install DESTDIR=$PKG

strip --strip-unneeded $PKG/usr/sbin/$PRGNAM

MANPAGE=$PKG/usr/man/man8/$PRGNAM.8
chmod 644 $MANPAGE
chown root:root $MANPAGE
gzip -9 $MANPAGE

mkdir -p $PKG/etc/$PRGNAM
echo "127.0.0.1" > $PKG/etc/$PRGNAM/whitelist.new
cat << 'EOF' > $PKG/etc/$PRGNAM/$PRGNAM.conf.new
SPFMILTER_USER=postfix
SPFMILTER_SOCKET=inet:2526@localhost
SPFMILTER_PIDFILE=/var/run/spfmilter.pid
SPFMILTER_WHITELIST=/etc/spfmilter/whitelist
SPFMILTER_OPTIONS=""
EOF

mkdir -p $PKG/etc/rc.d
cat << 'EOF' > $PKG/etc/rc.d/rc.$PRGNAM.new
#!/bin/sh

source /etc/spfmilter/spfmilter.conf
export SPFMILTER_OPTIONS SPFMILTER_SOCKET SPFMILTER_PIDFILE SPFMILTER_WHITELIST 

start() {
    echo "Starting spfmilter"
    /usr/sbin/spfmilter \
      --user "$SPFMILTER_USER" \
      --pidfile "$SPFMILTER_PIDFILE" \
      --whitelist "$SPFMILTER_WHITELIST" \
      $SPFMILTER_OPTIONS $SPFMILTER_SOCKET
}

stop() {
  echo "Shutting down spfmilter"
  pkill -f /usr/sbin/spfmilter
  sleep 3
  [ -f "$SPFMILTER_PIDFILE" ] && rm "$SPFMILTER_PIDFILE"
}

case "$1" in
  start)
    start;;
  stop)
    stop;;
  restart|reload)
    stop;start;;
  *)
    echo "Usage: $0 {start|stop|restart}";;
esac
EOF

PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC
cp -a \
  README \
  $PKGDOC
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
