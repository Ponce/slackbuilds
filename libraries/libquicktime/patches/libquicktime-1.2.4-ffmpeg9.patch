diff -Naur libquicktime-1.2.4.orig/plugins/ffmpeg/audio.c libquicktime-1.2.4/plugins/ffmpeg/audio.c
--- libquicktime-1.2.4.orig/plugins/ffmpeg/audio.c	2012-03-29 21:44:28.000000000 +0200
+++ libquicktime-1.2.4/plugins/ffmpeg/audio.c	2026-08-07 12:25:07.397156161 +0200
@@ -1203,9 +1203,14 @@
 
     codec->avctx->codec_id = codec->encoder->id;
     codec->avctx->codec_type = codec->encoder->type;
-
-    codec->avctx->sample_fmt = codec->encoder->sample_fmts[0];
-
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 0, 100)
+      const enum AVSampleFormat *sample_fmts = NULL;
+      avcodec_get_supported_config(codec->avctx, codec->encoder, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0, (const void**)&sample_fmts, NULL);
+      if(sample_fmts)
+        codec->avctx->sample_fmt = sample_fmts[0];
+#else
+        codec->avctx->sample_fmt = codec->encoder->sample_fmts[0];
+#endif
     
 #if LIBAVCODEC_VERSION_MAJOR < 54
     if(avcodec_open(codec->avctx, codec->encoder) != 0)
diff -Naur libquicktime-1.2.4.orig/plugins/ffmpeg/video.c libquicktime-1.2.4/plugins/ffmpeg/video.c
--- libquicktime-1.2.4.orig/plugins/ffmpeg/video.c	2012-02-25 20:46:56.000000000 +0100
+++ libquicktime-1.2.4/plugins/ffmpeg/video.c	2026-08-07 12:34:51.388332456 +0200
@@ -340,6 +340,17 @@
 static int lqt_tenbit_dnxhd_supported(AVCodec const* codec)
   {
   int i;
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 0, 100)
+  const enum AVPixelFormat *pix_fmts = NULL;
+  avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_PIX_FORMAT, 0, (const void**)&pix_fmts, NULL);
+  if(!pix_fmts)
+    return 0;
+  for(i = 0; pix_fmts[i] != AV_PIX_FMT_NONE; ++i)
+  {
+    if(pix_fmts[i] == AV_PIX_FMT_YUV422P10)
+      return 1;
+  }
+#else
   if (!codec->pix_fmts)
     return 0;
 
@@ -348,7 +359,7 @@
     if (codec->pix_fmts[i] == PIX_FMT_YUV422P10_OR_DUMMY)
       return 1;
     }
-
+#endif
   return 0;
   }
 
