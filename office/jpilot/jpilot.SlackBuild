cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=jpilot
VERSION=${VERSION:-2.0.3}
DOTVERSION=${VERSION}
USCOREVERSION=${VERSION//./_}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$DOTVERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLCKFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$DOTVERSION $PRGNAM-$USCOREVERSION
tar xvf $CWD/$PRGNAM-$USCOREVERSION.tar.gz
mv $PRGNAM-$USCOREVERSION $PRGNAM-$DOTVERSION
cd $PRGNAM-$DOTVERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

sed -i -e 's/return Contact_add_blob(c, blob);/return Contact_add_blob(c, (void*)blob);/' jp-contact.c

# I confirmed that version number is in fact 2.0.3:
sed  -i -e 's/AC_INIT(jpilot, 2.0.2)/AC_INIT(jpilot, 2.0.3)/' configure.in

CFLAGS="$SLKCFLAGS -std=gnu99 -fcommon" \
CXXFLAGS="$SLKCFLAGS -std=gnu99" \
conf_flags="--prefix=/usr \
            --libdir=/usr/lib${LIBDIRSUFFIX} \
            --sysconfdir=/etc \
            --localstatedir=/var \
            --mandir=/usr/man \
            --docdir=/usr/doc \
            --build=$ARCH-slackware-linux" \
	  ./autogen.sh

make
make install-strip DESTDIR=$PKG

find $PKG/usr/man -type f -exec gzip -9 {} \;
for i in $( find $PKG/usr/man -type l ) ; do ln -s $( readlink $i ).gz $i.gz ; rm $i ; done

mkdir $PKG/usr/doc
mv $PKG/usr/share/doc/$PRGNAM $PKG/usr/doc/$PRGNAM-$DOTVERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$DOTVERSION/$PRGNAM.SlackBuild
rm $PKG/usr/doc/$PRGNAM-$DOTVERSION/INSTALL
rmdir $PKG/usr/share/doc
find $PKG/usr/doc/$PRGNAM-$DOTVERSION -type f -exec chmod 644 {} \;

sed -i -e 's/Icon=jpilot.xpm/Icon=jpilot/' $PKG/usr/share/applications/jpilot.desktop

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$DOTVERSION-$ARCH-$BUILD$TAG.$PKGTYPE
