# (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;
# LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND
# ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
# (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS
# SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=dmd
VERSION=${VERSION:-2.113.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

BOOTSTRAP_VERSION=2.112.0

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "x86_64" ]; then
  LIBDIRSUFFIX="64"
  ARCHSUFFIX="64"
else
  LIBDIRSUFFIX=""
  ARCHSUFFIX="32"
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-${VERSION} phobos-$VERSION dmd2 install
tar xvf $CWD/$PRGNAM.$BOOTSTRAP_VERSION.linux.tar.xz
tar zxvf $CWD/$PRGNAM-$VERSION.tar.gz
tar zxvf $CWD/phobos-$VERSION.tar.gz

chown -R root:root $PRGNAM-$VERSION phobos-$VERSION
find -L $PRGNAM-$VERSION phobos-$VERSION \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

cd $PRGNAM-$VERSION
make HOST_DMD=$TMP/dmd2/linux/bin${ARCHSUFFIX}/dmd ENABLE_RELEASE=1 install

cd ../phobos-$VERSION
make DMD_DIR=../dmd-$VERSION install

cd $TMP/install

mkdir $PKG/etc
sed -e "s|%@P%/../../src/phobos -I%@P%/../../src/druntime/import|/usr/include/dmd|g" \
    -e "s|%@P%/../lib32|/usr/lib|" \
    -e "s|%@P%/../lib64|/usr/lib64|" \
    linux/bin${ARCHSUFFIX}/dmd.conf > $PKG/etc/dmd.conf

mkdir -p $PKG/usr/bin
mv linux/bin${ARCHSUFFIX}/dmd $PKG/usr/bin

mkdir -p $PKG/usr/lib${LIBDIRSUFFIX} $PKG/usr/include

# Runtime.
mv src/druntime/import $PKG/usr/include/dmd

# Phobos.
mv linux/lib${ARCHSUFFIX}/libphobos2.* $PKG/usr/lib${LIBDIRSUFFIX}
mv src/phobos/std $PKG/usr/include/dmd
mv src/phobos/etc/c $PKG/usr/include/dmd/etc
rm -r $PKG/usr/include/dmd/etc/c/zlib

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mv man $PKG/usr
find $PKG/usr/man -type f -exec gzip -9 {} \;
for i in $( find $PKG/usr/man -type l ) ; do ln -s $( readlink $i ).gz $i.gz ; rm $i ; done

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
