# Fix shiboken2 type lookup for bare nested enums with modern libclang.
#
# Symptom: QDragMoveEvent / QHoverEvent / QKeyEvent / QMouseEvent wrappers
# generate QFlags<QOpenGLShader::ShaderTypeBit> and QOpenGLShader::DragMove
# instead of QEvent::Type / QEvent::DragMove.
#
# Causes:
# 1. libclang spells nested enum params as bare "Type" while the declaration
#    type is "QEvent::Type" (same CXType_Enum kind), so the clang-16
#    resolveType() helper did not upgrade the name.
# 2. findTypeEntries() only checked direct base classes, so
#    QDragMoveEvent -> QDropEvent never reached QEvent::Type.
# 3. findFlagsType("Type") used endsWith("Type"), matching ShaderType.
#
# Apply after the Debian clang-16 patch series.

--- a/sources/shiboken2/ApiExtractor/clangparser/clangutils.cpp
+++ b/sources/shiboken2/ApiExtractor/clangparser/clangutils.cpp
@@ -135,26 +135,37 @@
     return kind >= CXType_FirstBuiltin && kind <= CXType_LastBuiltin;
 }
 
-// Resolve elaborated types occurring with clang 16
+QString getTypeName(const CXType &type)
+{
+    CXString typeSpelling = clang_getTypeSpelling(type);
+    const QString result = QString::fromUtf8(clang_getCString(typeSpelling));
+    clang_disposeString(typeSpelling);
+    return result;
+}
+
+// Resolve elaborated types occurring with clang 16+.
+// Also prefer the declaration type when kinds match but the declaration is
+// more qualified: clang may spell nested enums used without qualification as
+// bare "Type" while the declaration type is "QEvent::Type" (same CXType_Enum).
+// Without this, type lookup falls through to findFlagsType("Type") and can
+// match unrelated flags such as QOpenGLShader::ShaderType (ends with "Type").
 static CXType resolveType(const CXType &type)
 {
     if (!isBuiltinType(type.kind)) {
         CXCursor decl = clang_getTypeDeclaration(type);
         auto resolvedType = clang_getCursorType(decl);
-        if (resolvedType.kind != CXType_Invalid && resolvedType.kind != type.kind)
-            return resolvedType;
+        if (resolvedType.kind != CXType_Invalid) {
+            if (resolvedType.kind != type.kind)
+                return resolvedType;
+            const QString typeName = getTypeName(type);
+            const QString resolvedName = getTypeName(resolvedType);
+            if (typeName != resolvedName && resolvedName.contains(QLatin1String("::")))
+                return resolvedType;
+        }
     }
     return type;
 }
 
