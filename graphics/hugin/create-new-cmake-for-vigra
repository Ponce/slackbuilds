cat << 'EOF' > CMakeModules/FindVIGRA.cmake
SET(VIGRA_FOUND "NO")

FIND_PATH(VIGRA_INCLUDE_DIR vigra/gaborfilter.hxx
  /usr/local/include
  /usr/include
  /opt/local/include
)

FIND_LIBRARY(VIGRA_LIBRARIES
  NAMES vigraimpex libvigraimpex
  PATHS /usr/lib /usr/local/lib /opt/local/lib
)

IF(VIGRA_INCLUDE_DIR AND VIGRA_LIBRARIES)
  SET(VIGRA_FOUND TRUE)
ENDIF()

IF(VIGRA_FOUND)
  MESSAGE(STATUS "Found VIGRA: ${VIGRA_LIBRARIES}")
  FIND_FILE(
    VIGRA_CONFIG_VERSION_HXX
    NAMES configVersion.hxx config_version.hxx
    PATHS "${VIGRA_INCLUDE_DIR}/vigra/"
  )
  IF(NOT VIGRA_CONFIG_VERSION_HXX)
    MESSAGE(FATAL_ERROR "Could not find vigra/configVersion.hxx or vigra/config_version.hxx.")
  ENDIF()

  FILE(STRINGS "${VIGRA_CONFIG_VERSION_HXX}" VIGRA_VERSION_HXX REGEX ".*#define +VIGRA_VERSION +\"")
  IF(VIGRA_VERSION_HXX)
    STRING(REGEX REPLACE ".*#define +VIGRA_VERSION +\"([.0-9]+).*" "\\1" VIGRA_VERSION "${VIGRA_VERSION_HXX}")
  ELSE()
    FILE(READ "${VIGRA_CONFIG_VERSION_HXX}" VIGRA_CONFIG_CONTENT)
    STRING(REGEX MATCH "#define VIGRA_VERSION_MAJOR ([0-9]+)" _ "${VIGRA_CONFIG_CONTENT}")
    SET(VIGRA_MAJOR "${CMAKE_MATCH_1}")
    STRING(REGEX MATCH "#define VIGRA_VERSION_MINOR ([0-9]+)" _ "${VIGRA_CONFIG_CONTENT}")
    SET(VIGRA_MINOR "${CMAKE_MATCH_1}")
    STRING(REGEX MATCH "#define VIGRA_VERSION_PATCH ([0-9]+)" _ "${VIGRA_CONFIG_CONTENT}")
    SET(VIGRA_PATCH "${CMAKE_MATCH_1}")
    SET(VIGRA_VERSION "${VIGRA_MAJOR}.${VIGRA_MINOR}.${VIGRA_PATCH}")
  ENDIF()

  IF(${VIGRA_VERSION} VERSION_EQUAL VIGRA_FIND_VERSION OR ${VIGRA_VERSION} VERSION_GREATER VIGRA_FIND_VERSION)
    SET(VIGRA_VERSION_CHECK TRUE)
    MESSAGE(STATUS "VIGRA version: ${VIGRA_VERSION}")
  ELSE()
    MESSAGE(FATAL_ERROR "VIGRA lib is too old. Found version ${VIGRA_VERSION}.")
  ENDIF()

  IF(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    FIND_PROGRAM(LDD_EXECUTABLE ldd)
    IF(LDD_EXECUTABLE)
      EXECUTE_PROCESS(
        COMMAND ${LDD_EXECUTABLE} ${VIGRA_LIBRARIES}
        OUTPUT_VARIABLE OUTPUT_LDD_VIGRA
        OUTPUT_STRIP_TRAILING_WHITESPACE
      )
      STRING(TOLOWER "${OUTPUT_LDD_VIGRA}" OUTPUT_LDD_VIGRA_LOWER)
      IF(NOT "${OUTPUT_LDD_VIGRA_LOWER}" MATCHES "libilmimf|libopenexr")
        MESSAGE(FATAL_ERROR "vigraimpex seems to be compiled without OpenEXR support.")
      ENDIF()
    ENDIF()
  ENDIF()
ELSE()
  MESSAGE(FATAL_ERROR "Could not find VIGRA")
ENDIF()

MARK_AS_ADVANCED(VIGRA_LIBRARIES VIGRA_INCLUDE_DIR)
EOF

