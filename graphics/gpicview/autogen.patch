Date: Tue, 17 Nov 2026 13:33:42 +0100
Subject: [PATCH] Fix autogen.sh to work with latest automake

---
 autogen.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/autogen.sh b/autogen.sh
index 9889a49..daeb68f 100755
--- a/autogen.sh
+++ b/autogen.sh
@@ -6,7 +6,7 @@ AM_INSTALLED_VERSION=$($AUTOMAKE --version | sed -e '2,$ d' -e 's/.* \([0-9]*\.[
 
 # FIXME: we need a better way for version check later.
 case "$AM_INSTALLED_VERSION" in
-    1.1[1-9])
+    1.2[0-9]|1.1[1-9])
 	;;
     *)
 	echo
