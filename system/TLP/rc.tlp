#!/bin/sh
# /etc/rc.d/rc.tlp
#
# Start/stop/restart/status for TLP power management.

TLP=/usr/sbin/tlp
TLPSTAT=/usr/bin/tlp-stat

case "$1" in
  start)
    echo "Starting TLP: applying power settings..."
    "$TLP" init start
    ;;
  stop)
    echo "Stopping TLP: reverting power settings..."
    "$TLP" init stop
    ;;
  restart)
    echo "Restarting TLP: reapplying power settings..."
    "$TLP" init restart
    ;;
  status)
    "$TLPSTAT" -s
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
