#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=fonts-uw-ttyp0
VERSION=${VERSION:-2.1}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
ARCH=noarch
PKGTYPE=${PKGTYPE:-tgz}

if [ -n "$PRINT_PACKAGE_NAME" ]; then
  echo $PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}
SRCNAM=uw-ttyp0

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT

cd $TMP
rm -rf $SRCNAM-$VERSION

if ! ls $CWD/$SRCNAM-$VERSION.tar.?z* >/dev/null 2>&1; then
  echo "Source archive for $SRCNAM-$VERSION not found."
  exit 1
fi

tar xvf $CWD/$SRCNAM-$VERSION.tar.?z*
cd $SRCNAM-$VERSION

chown -R root:root .

# Generate the X11 and Linux console font formats.  The source defaults to
# PCF and OTB only, so enable the Linux console target for this package.
sed -i 's/^GEN_CONS_LINUX[[:space:]]*=[[:space:]]*0/GEN_CONS_LINUX = 1/' \
  TARGETS.dat

# Select the dotted zero variant; replace Digit0Dotted to choose another one.
sed -i 's/^#COPYTO Digit0Dotted Digit0$/COPYTO Digit0Dotted Digit0/' \
  VARIANTS.dat

./configure \
  --prefix=/usr \
  --pcfdir=/usr/share/fonts/X11/misc \
  --otbdir=/usr/share/fonts/misc/uw-ttyp0 \
  --conslinuxdir=/usr/share/kbd/consolefonts \
  --bindir=/usr/bin \
  --mandir=/usr/man \
  --docdir=/usr/doc/$PRGNAM-$VERSION

make
make install install-util install-doc DESTDIR=$PKG

# Font indexes are generated by doinst.sh after installation.
rm -f \
  $PKG/usr/share/fonts/misc/uw-ttyp0/fonts.dir \
  $PKG/usr/share/fonts/misc/uw-ttyp0/fonts.scale \
  $PKG/usr/share/fonts/X11/misc/fonts.dir \
  $PKG/usr/share/fonts/X11/misc/fonts.scale

find $PKG -print0 | xargs -0 file | grep ELF | cut -f1 -d: | \
  xargs strip --strip-unneeded 2>/dev/null || true

gzip -9 $PKG/usr/man/man1/bdfmangle.1

cp $CWD/$PRGNAM.SlackBuild $PKG/usr/doc/$PRGNAM-$VERSION/

mkdir -p $PKG/install
install -m 644 "$CWD/slack-desc" "$PKG/install/"
install -m 644 $CWD/doinst.sh $PKG/install/

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
