#!/bin/bash

# Slackware build script for ttf-nerd-fonts-saucecodepro

# Written by B. Watson (urchlay@slackware.uk)

# Licensed under the WTFPL. See http://www.wtfpl.net/txt/copying/ for details.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=ttf-nerd-fonts-saucecodepro
SRCNAM=SourceCodePro
VERSION=${VERSION:-3.5.1}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}
ARCH=noarch

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e

PKGFONTS=$PKG/usr/share/fonts/TTF/
PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION

# no source directory, extract straight to $PKG.
rm -rf $PKG
mkdir -p $TMP $PKGFONTS $PKGDOC $OUTPUT
cd $PKGFONTS
tar xvf $CWD/$SRCNAM.tar.xz --no-same-owner
chmod 644 *
mv *.md *.txt $PKGDOC
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
# not an error: use the same file for doinst and douninst.
cat $CWD/doinst.sh > $PKG/install/doinst.sh
cat $CWD/doinst.sh > $PKG/install/douninst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
