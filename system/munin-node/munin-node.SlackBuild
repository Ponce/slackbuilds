#!/bin/bash

# Slackware Package Build Script for munin-node (http://munin-monitoring.org)
# SlackBuild source at https://github.com/glitchwrks/munin-node-slackbuild

# See LICENSE included in the project root for licensing information.

# Copyright (c) 2025 Glitch Works, LLC
# http://www.glitchwrks.com/
# Copyright (c) 2015 Jonathan Chapman
# glitch@glitchwrks.com
# All rights reserved.

# 20261101 glitch@glitchwrks.com, BUILD=2:
# - install to /usr/lib/munin rather than straight into /usr/lib.
# - Java is optional: the JMX plugins are only built with JMX=yes, so
#   zulu-openjdk8 is no longer required. Without JMX=yes, Java plugins
#   aren't built even if a JDK is installed.
# - PID file in /var/run, not /var/run/munin: /var/run doesn't survive a
#   reboot, so the package's /var/run/munin was gone after the first one.
#   The package no longer ships anything under /var/run.
# - Perl modules go to Perl's vendor_perl, not core Perl's /usr/share/perl5.

# 20251008 glitch@glitchwrks.com
# - updated for Munin 2.0.76

# 20220212 bkw: Modified by SlackBuilds.org, BUILD=2:
# - add a documentation directory (/usr/doc/$PRGNAM-$VERSION).
# - add the SlackBuild to the doc dir.

# 20220212 bkw: Modified by SlackBuilds.org:
# - fix download URL.
# - add missing dependencies to REQUIRES.
# - fix build (PERL5LIB).
# - add -j1 to make commands, since parallel builds don't work.
# - install plugins to $PKG, not the real root fs!

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=munin-node
VERSION=${VERSION:-2.0.76}
BUILD=${BUILD:-2}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}
ARCH="noarch"

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

ARCHIVE_NAME=munin

set -e

# Clean up old builds
rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $ARCHIVE_NAME-$VERSION
tar zxvf $CWD/"$ARCHIVE_NAME"-"$VERSION".tar.gz
cd $ARCHIVE_NAME-$VERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \+

# Patch Makefile.config for Slackware-esque install locations
patch Makefile.config < $CWD/patches/Makefile.config.patch

# 20220212 bkw: Note: plugins are in /usr/lib/munin/plugins, regardless of
# build architecture, because this is noarch.
export PERL5LIB=.

# Perl modules go in vendor_perl. Makefile.config's default is site_perl,
# which on Slackware is under /usr/local.
VENDORLIB=$(perl -MConfig -e 'print $Config{vendorlib}')

# The JMX plugins need a JDK to build and a JRE to run. Munin builds them
# whenever javac is found, so turn that off explicitly unless JMX=yes.
# Munin compiles them for Java 7, which javac 20 and later reject; Java 8
# works with zulu-openjdk8 and newer JDKs alike.
if [ "${JMX:-no}" = "yes" ]; then
  JAVA_OPTS=("JAVARUN=${JAVARUN:-/usr/bin/java}" "JFLAGS=-g -source 1.8 -target 1.8 -Xlint")
  JAVA_INSTALL="install-plugins-java"
else
  JAVA_OPTS=("JCVALID=no")
  JAVA_INSTALL=""
fi

make -j1 PERLLIB=$VENDORLIB "${JAVA_OPTS[@]}"
make -j1 install-common-prime install-node-prime \
	install-plugins-prime $JAVA_INSTALL \
	PERLLIB=$PKG$VENDORLIB "${JAVA_OPTS[@]}" DESTDIR=$PKG

find $PKG/usr/man -type f -exec gzip -9 {} \;
for i in $( find $PKG/usr/man -type l ) ; do ln -s $( readlink $i ).gz $i.gz ; rm $i ; done

# Nothing belongs under /usr/local in a package.
rm -rf $PKG/usr/local

# install-pre creates and chowns STATEDIR (/var/run) to munin. Don't ship it:
# /var/run exists already, and munin-node writes its PID file there as root.
rm -rf $PKG/var/run

# 20220426 bkw: docs, please.
# TODO: maintainer, you should figure out to build the HTML docs using
# the RST source in the doc/ dir, and include those in the package.
PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC
cp -a COPYING ChangeLog HACKING.pod README UPGRADING* $PKGDOC
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

# move config files to .new
cd $PKG/etc/munin
for file in $(find . -type f); do
	mv $file "$file.new"
done

install -D -m 0644 $CWD/rc.munin-node $PKG/etc/rc.d/rc.munin-node.new
install -D -m 0644 $CWD/munin-node.logrotate $PKG/etc/logrotate.d/munin-node.new

# Finish up the package
mkdir -p $PKG/install
cat $CWD/doinst.sh > $PKG/install/doinst.sh
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
