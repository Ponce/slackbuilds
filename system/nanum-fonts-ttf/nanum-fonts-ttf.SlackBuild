cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=nanum-fonts-ttf
VERSION=${VERSION:-20250212}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}
ARCH=noarch
SRCNAM=fonts-nanum-debian

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e
trap 'echo "$0 FAILED at line $LINENO!" | tee -a  $OUTPUT/error-${PRGNAM}.log' ERR

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $SRCNAM-$VERSION-1
tar xvf $CWD/$SRCNAM-$VERSION-1.tar.gz
cd $SRCNAM-$VERSION-1
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \+

mkdir -pv $PKG/usr/share/fonts/TTF

find $TMP/$SRCNAM-$VERSION-1/ -name '*.ttf' -type f -exec install -D -m0644 -v {} -t $PKG/usr/share/fonts/TTF \;
find $TMP/$SRCNAM-$VERSION-1/ -name '*.ttc' -type f -exec install -D -m0644 -v {} -t $PKG/usr/share/fonts/TTF \;

find $PKG/usr/share/fonts/TTF -type f -exec chmod 0644 {} \+

mkdir -pv $PKG/etc/fonts/conf.avail
find . -name "*.conf" -exec cp -a {} $PKG/etc/fonts/conf.avail \;
mkdir -pv $PKG/etc/fonts/conf.d
( cd $PKG/etc/fonts/conf.d && ln -sf ../conf.avail/* .)

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/COPYRIGHT.txt > $PKG/usr/doc/$PRGNAM-$VERSION/COPYRIGHT.txt
cp -av $TMP/$SRCNAM-$VERSION-1/debian/{copyright,README.Debian,README.source} $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild
find $PKG/usr/doc/$PRGNAM-$VERSION -type f -exec chmod 0644 {} \+

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n --remove-rpaths --remove-tmp-rpaths $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
