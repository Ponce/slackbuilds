#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.


cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=kopia
VERSION=${VERSION:-0.23.1}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
elif [ "$ARCH" = "aarch64" ]; then
  SLKCFLAGS="-O2 -fPIC"
else
  SLKCFLAGS="-O2"
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $CWD/$PRGNAM-$VERSION.tar.gz
cd $PRGNAM-$VERSION
chown -R root:root .

find . ! -type l -perm /6000 -exec chmod a-s {} +
find . ! -type l -type d ! -perm 755 -exec chmod -f 755 {} +
find . ! -type l -type f -perm /111 ! -perm 755 -exec chmod -f 755 {} +
find . ! -type l -type f ! -perm /111 ! -perm 644 -exec chmod -f 644 {} +

# Ensure google-go-lang is used
. /etc/profile.d/go.sh

export GOPATH="$TMP/go-$PRGNAM"
export GOMODCACHE="$GOPATH/pkg/mod"
export GOCACHE="$TMP/gocache-$PRGNAM"
export GOPROXY="${GOPROXY:-https://proxy.golang.org,direct}"
export GOSUMDB=sum.golang.org
export GOTOOLCHAIN=local
export GOFLAGS="-mod=vendor -trimpath -modcacherw -buildvcs=false"
export CGO_ENABLED=1

export CGO_CPPFLAGS="$CPPFLAGS"
export CGO_CFLAGS="$SLKCFLAGS"
export CGO_CXXFLAGS="$SLKCFLAGS"
export CGO_LDFLAGS="$LDFLAGS"

if [ -r "$CWD"/"$PRGNAM"-"${VERSION}"-vendor.tar.xz ]; then
  echo -n "Unpacking vendor tarball ..."
  tar xf "$CWD"/"$PRGNAM"-"$VERSION"-vendor.tar.xz
  echo
else
  echo "Creating vendorball ... "
  go mod vendor
  tar cvf - vendor | xz -c > "$CWD"/"$PRGNAM"-"$VERSION"-vendor.tar.xz
  md5sum "$CWD"/"$PRGNAM"-"$VERSION"-vendor.tar.xz
  echo "MSG to self: Created vendorball - remember to upload it!"
fi

go build -ldflags "\
 -linkmode=external \
 -s -w \
 -X github.com/kopia/kopia/repo.BuildVersion=$VERSION \
 -X github.com/kopia/kopia/repo.BuildInfo=SlackBuilds.org \
 -X github.com/kopia/kopia/repo.BuildGitHubRepo=kopia/kopia" \
 -o $PRGNAM .

mkdir -p $PKG/usr/bin
install -m 0755 $PRGNAM $PKG/usr/bin/$PRGNAM

mkdir -p $PKG/usr/share/bash-completion/completions \
         $PKG/usr/share/zsh/site-functions
./$PRGNAM --completion-script-bash > $PKG/usr/share/bash-completion/completions/$PRGNAM
./$PRGNAM --completion-script-zsh  > $PKG/usr/share/zsh/site-functions/_$PRGNAM

install -m 0755 $CWD/kopia-server $PKG/usr/bin/kopia-server


mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a \
  *.md LICENSE* \
  $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc


cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
