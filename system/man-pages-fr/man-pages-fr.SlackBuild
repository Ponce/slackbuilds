# Now maintained by B. Watson <urchlay@slackware.uk>

# Note: on version update, run: find_conflicts.sh > conflicts.pages

# 20261010 bkw: update for v3.70_8 from Rosa 13, which seems to be the
# newest version. Since it's a noarch package, I don't feel bad about
# repacking it. The RPM contains man pages from more sources than just
# the ones at free.fr. The man pages are .xz, not .gz, but Slackware's
# man-db supports .xz man pages already. I had to modify sbopkglint
# to allow .xz man pages, so make sure you use the latest version of
# sbo-maintainer-tools to lint this!

# 20260830 bkw: BUILD=5, fix conflicts with Slackware's procps-ng.
# 20230109 bkw: BUILD=4
# - get rid of empty /usr/doc/man-pages-fr/ dir.
# - remove a couple of *English* man pages (how'd those get there?)

# 20210828 bkw: BUILD=3.
# - Make UTF8=yes the default (works better with man-db).

# 20170626 bkw:
# - Take over maintenance, BUILD=2.
# - Combine old man-pages-extras-fr build with this one. I can't
#   think of a reason why anyone would ever want to install one but
#   not the other.
# - Add UTF8 option.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=man-pages-fr
VERSION=${VERSION:-3.70_8}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

# Hardcode ARCH
ARCH=noarch

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

XTRANAM=man-pages-extras-fr
XTRAVER=${XTRAVER:-0.8.1}

set -e

RPMVER=${VERSION/_/-}
RPM=$CWD/$PRGNAM-$RPMVER-rosa13.noarch.rpm
PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT $PKGDOC
cd $PKG

# The .rpm file already has correct perms and owners root:root.
# It ships an etc/cron.weekly script and empty cache dirs in
# var/cache, which we don't need. As usual, the docs are in the
# wrong place for Slackware.
rpm2cpio $RPM | cpio -i -m -d

mv usr/share/doc/$PRGNAM/* $PKGDOC
mv usr/share/man usr/man
rm -rf usr/share etc var usr/man/fr/{cat*,index.db}

# Get rid of man pages that conflict with Slackware's... except for a
# few where the Slackware one isn't fully translated into French, and
# still has sections in English.
# See the find_conflicts.sh script for details.
( cd $PKG/usr/man/fr ; rm -f $( cat $CWD/conflicts.pages ) )

# Slackware's got English ld-linux and ld-linux.so pages, which just
# source the ld.so one. Do the same here.
for i in ld-linux ld-linux.so; do
  ln -s ld.so.8.xz $PKG/usr/man/fr/man8/$i.8.xz
done

cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
