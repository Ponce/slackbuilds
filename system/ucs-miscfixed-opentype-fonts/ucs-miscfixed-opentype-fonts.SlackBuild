# 20261004 bkw: Modified by SlackBuilds.org: get rid of ARCH stuff
# since this is noarch.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=ucs-miscfixed-opentype-fonts
VERSION=${VERSION:-0.3_29alma}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}
ARCH=noarch

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TARNAM=$PRGNAM-0.3-29.el9.noarch.rpm

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
mkdir $PRGNAM-$VERSION
cd $PRGNAM-$VERSION

rpm2cpio $CWD/$TARNAM | cpio -i --make-directories --no-preserve-owner

rm ./etc/fonts/conf.d/66-ucs-miscfixed.conf

find . ! -type l    -a \( \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \) \)

mkdir -p $PKG/usr/share/fonts/OTF
find . -path "*.otb" -exec cp {} $PKG/usr/share/fonts/OTF/ \;

mkdir -p $PKG/etc/fonts/conf.avail/
cat $CWD/66-ucs-miscfixed.conf > $PKG/etc/fonts/conf.avail/66-ucs-miscfixed.conf

PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC

cp -a ./usr/share/doc/ucs-miscfixed-opentype-fonts/README \
   $PKGDOC/

chmod 644 $PKGDOC/*

cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
