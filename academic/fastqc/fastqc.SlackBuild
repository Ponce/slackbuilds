#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=fastqc
SRCNAM=FastQC
VERSION=${VERSION:-0.13.0}
SRCVER=${SRCVER:-v0.13.0}

BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

ARCH=noarch

# Jar files names and versions
COMIO=commons-io-2.22.0.jar
COMCOM=commons-compress-1.28.0.jar
HTS=htsjdk.jar
CISD=cisd-jhdf5.jar

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $SRCNAM
unzip $CWD/${PRGNAM}_${SRCVER}.zip 
cd $SRCNAM

find . ! -type l    -a \( \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \) \)

# remove .svn folders causing java errors e.g. when using help
find -d -name .svn -exec rm -r '{}' ';'

SHRPRG=share/$PRGNAM-$VERSION
PKGPRG=$PKG/usr/$SHRPRG/$PRGNAM
mkdir -p $PKGPRG
install -D -m755 $PRGNAM $PKGPRG
cp -a \
      Configuration net org Templates Help uk $COMIO $COMCOM $HTS $CISD \
      $PKGPRG

mkdir -p $PKG/usr/bin
cd $PKG/usr/bin
ln -s ../$SHRPRG/$PRGNAM/$PRGNAM
cd -

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC

cd $PKGDOC
ln -s ../../$SHRPRG/$PRGNAM/ Help
cd -
cp -a \
      RELEASE_NOTES.txt README.md LICENSE* \
      $PKGDOC
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

# Menu item and icon
PKGSHR=$PKG/usr/share
mkdir -p $PKGSHR/{applications,pixmaps}
cp $CWD/$PRGNAM.desktop $PKGSHR/applications
cp $CWD/$PRGNAM.png $PKGSHR/pixmaps

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
