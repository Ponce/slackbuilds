From: Jeff Claar <jclaar3@cox.net>
Date: Thu, 1 Aug 2024 15:40:02 -0700
Subject: [PATCH 2/2] Fixed "knock down" syntax

---
 mdlfun/dung.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mdlfun/dung.cpp b/mdlfun/dung.cpp
index 585b9ce..95b4986 100644
--- a/mdlfun/dung.cpp
+++ b/mdlfun/dung.cpp
@@ -508,7 +508,7 @@ namespace
         add_action("KNOCK", "Knock", ActionVec{
             AnyV{ "AT", obj(), AVSyntax("KNOCK", knock()), driver() },
             AnyV{ "ON", obj(), AVSyntax("KNOCK", knock()) },
-            AnyV{ "DOWN", AL{ Bits::vicbit, reach(), robjs() }, AVSyntax("ATTAC", attacker()) }
+            AnyV{ "DOWN", AL{ Bits::vicbit, eq(), reach(), robjs() }, AVSyntax("ATTAC", attacker()) }
         });
         vsynonym("KNOCK", "RAP" );
 
