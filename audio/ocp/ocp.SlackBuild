#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

# 20260930 bkw: Modified by SlackBuilds.org, BUILD=2:
# - use private copy of gnu-unifont (remove it from REQUIRES).
# - actually ship the .desktop and mime info.
# - stop writing outside of $TMP.
# - pre-emptively update to new template.
# - mention option SDL3 in README.
# - doinst.sh and douninst.sh: do not use chroot for install-info.
# - update desktop and mime databases in doinst.sh.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=ocp
VERSION=${VERSION:-3.5.0}
FONTVER=${FONTVER:-15.0.01}
BUILD=${BUILD:-2}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $CWD/$PRGNAM-$VERSION.tar.xz --no-same-owner
cd $PRGNAM-$VERSION
tar xvf $CWD/unifont-$FONTVER.tar.gz --no-same-owner
find . ! -type l    -a \( \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \) \)

CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
./configure \
  --prefix=/usr \
  --libdir=/usr/lib${LIBDIRSUFFIX} \
  --sysconfdir=/etc \
  --localstatedir=/var \
  --mandir=/usr/man \
  --docdir=/usr/doc/$PRGNAM-$VERSION \
  --disable-static \
  --build=$ARCH-slackware-linux \
  --with-unifontdir-otf=/usr/share/fonts/OTF/ \
  --infodir=/usr/info \
  --without-update-desktop-database \
  --without-update_mime_database \
  --with-unifont-relative

make
make install DESTDIR=$PKG

# "make install-strip" not supported, so:
find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

rm -f $PKG/{,usr/}lib${LIBDIRSUFFIX}/*.la
gzip -9 $PKG/usr/man/man*/*
rm -rf $PKG/usr/info/dir
gzip -9 $PKG/usr/info/*.info*

# 20260930 bkw: Include a private copy of gnu-unifont in ocp's
# data dir, to avoid forcing the user to have gnu-unifont installed
# system wide (it actually causes problems for speakers of certain
# languages).
FONTDIR=$PKG/usr/share/ocp/data
for ext in otf ttf; do
  for variant in "" _csur _upper; do
    src=unifont-$FONTVER/font/precompiled/unifont$variant-$FONTVER.$ext
    dst=$FONTDIR/unifont$variant.$ext
    [ -e $src ] && cp $src $dst
  done
done

PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC
cp -a \
  AUTHORS BUGS COPYING CREDITS Changelog README.md \
  $PKGDOC
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh
cat $CWD/douninst.sh > $PKG/install/douninst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
